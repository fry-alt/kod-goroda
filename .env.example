# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Yandex AI Studio (основной вариант) ---
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и ID каталога
YC_API_KEY=
YC_FOLDER_ID=
# yandexgpt-5.1 (Pro 5.1) | yandexgpt-5-pro | aliceai-llm | aliceai-llm-flash | qwen3.6-35b-a3b ...
YANDEX_MODEL=yandexgpt-5.1

# --- Claude (запасной вариант) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_ITEM_EFFORT=low
CLAUDE_REPORT_EFFORT=high

# auto — Яндекс, если заданы YC_*; иначе Claude, если есть его ключ; иначе офлайн-правила
# можно явно: yandex | claude | offline
LLM_PROVIDER=auto
# Разметка комментариев для светофора: 0 — офлайн, 1 — LLM.
COMMENTS_LLM=0
BATCH_SIZE=10
WORKERS=4

# --- Интеграция с формами (Андрей) ---
# Секрет вебхука: тот же вписать в tools/google_forms.gs. Пусто — проверка выключена.
WEBHOOK_SECRET=
# CSV листов ответов Google Sheets (их печатает createForms в tools/google_forms.gs). Пусто — опрос выключен.
SHEET_CSV_INTERN=
SHEET_CSV_MENTOR=
POLL_SECONDS=5
# DB_PATH=data/app.db
